{
  "name": "@wnlx/redisq",
  "version": "0.1.0",
  "description": "Event-driven Redis Streams message broker for TypeScript",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "type": "module",
  "private": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taoohuu/redisq.git"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "keywords": [
    "redis",
    "queue",
    "redis-queue",
    "message-queue",
    "job-queue",
    "task-queue",
    "background-jobs",
    "event-emitter",
    "typescript",
    "delayed-jobs",
    "ioredis",
    "worker",
    "mq"
  ]
}
